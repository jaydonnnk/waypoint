# Waypoint backend — LIVE-rail deployment image.
#
# Unlike Dockerfile (recorded-rail, zero-credential-by-construction), this
# image installs the atlas-flight CLI so app/atlas/client.py's subprocess
# transport has a real binary to call. Sandbox credentials only (see
# docs/external/atlas-integration.md) — never point this at production
# Atlas without a deliberate, separate decision.
#
# atlas-flight requires Python >= 3.12 (backend app itself runs 3.11 —
# see app/atlas/client.py header) so the CLI gets its OWN venv via uv,
# isolated from the app's dependencies.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# --- atlas-flight CLI (its own Python 3.12 runtime via uv) ---------------
# curl + a 3.12 interpreter are the only extra system deps needed.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
RUN uv python install 3.12
# `uv tool install` shims the `atlas-flight` entrypoint into
# /root/.local/bin (already on PATH above) — it does NOT need the
# tool's own isolated venv bin dir on PATH, and adding that would
# shadow the base image's `python` with the CLI's 3.12 venv (which
# has no uvicorn), breaking the app's own start command.
RUN uv tool install --python 3.12 atlas-flight-booking==0.3.12

# keyrings.alt — installed into BOTH the app's 3.11 env (client.py's
# os.environ.setdefault needs it importable for validation) AND the
# atlas-flight CLI's own isolated 3.12 venv (the subprocess that
# actually reads/writes the keyring file). Missing from the CLI venv
# = auth status probe can't find the plaintext backend = falls back
# to default backend = AUTHORIZATION_REQUIRED = comparison mode even
# with WAYPOINT_LIVE_BOOKING=1.
RUN pip install --no-cache-dir keyrings.alt \
    && uv pip install --python /root/.local/share/uv/tools/atlas-flight-booking/bin/python keyrings.alt

# --- app dependencies ------------------------------------------------------
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App + operational scripts + the recording (kept so WAYPOINT_ATLAS_MODE
# can still fall back to recorded for a given run without rebuilding).
COPY app ./app
COPY scripts ./scripts
COPY data/recorded ./data/recorded
# Bot passport path (S3): the curated ISO-3->ISO-2 nationality CSV must be
# present for mrz.validate() to run when the bot is enabled.
COPY data/iso3_to_iso2.csv ./data/iso3_to_iso2.csv

RUN touch waypoint.db && chmod +x scripts/restore_atlas_keyring.sh

EXPOSE 8000

# ONE worker — one SQLite file; asyncio.to_thread DB access is the
# concurrency model (ADR 0007). Never add --workers > 1.
#
# restore_atlas_keyring.sh runs first (free-tier disk workaround — see
# its own header) then execs uvicorn so it stays PID 1 for signals.
CMD ["sh", "-c", "./scripts/restore_atlas_keyring.sh && exec python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1"]
